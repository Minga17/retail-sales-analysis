# Cell 1 — imports
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.ticker as mticker
import seaborn as sns
import warnings
warnings.filterwarnings('ignore')

# Style — makes charts look clean and professional
plt.rcParams['figure.facecolor'] = 'white'
plt.rcParams['axes.facecolor'] = '#fafafa'
plt.rcParams['axes.spines.top'] = False
plt.rcParams['axes.spines.right'] = False
plt.rcParams['font.family'] = 'DejaVu Sans'

print("Libraries loaded ✓")


# Cell 2 — load data
df = pd.read_csv('/kaggle/input/datasets/mingangolo/database/Sample_ Superstore.csv', encoding='latin-1')

print("Shape:", df.shape)
print("\nColumns:", df.columns.tolist())
df.head()


# Cell 3 — understand the data
print("=== DATA TYPES ===")
print(df.dtypes)

print("\n=== NULL VALUES ===")
print(df.isnull().sum())

print("\n=== DUPLICATES ===")
print("Duplicate rows:", df.duplicated().sum())

print("\n=== BASIC STATS ===")
df[['Sales', 'Profit', 'Quantity', 'Discount']].describe().round(2)


# Cell 4 — clean and prepare
# Fix date columns — using format='mixed' handles slash-separated dates
df['Order Date'] = pd.to_datetime(df['Order Date'], format='mixed', dayfirst=False)
df['Ship Date']  = pd.to_datetime(df['Ship Date'],  format='mixed', dayfirst=False)

# Add useful time columns
df['Year']       = df['Order Date'].dt.year
df['Month']      = df['Order Date'].dt.month
df['Month_Name'] = df['Order Date'].dt.strftime('%b')
df['YearMonth']  = df['Order Date'].dt.to_period('M')

# Drop duplicates just in case
df = df.drop_duplicates()

# Confirm
print("Cleaned shape:", df.shape)
print("Date range:", df['Order Date'].min().date(), "→", df['Order Date'].max().date())
print("Years in data:", sorted(df['Year'].unique()))
print("\nCategories:", df['Category'].unique())
print("Regions:", df['Region'].unique())


# Cell 5 — CHART 1: Monthly Sales Trend
monthly = df.groupby('YearMonth')['Sales'].sum().reset_index()
monthly['YearMonth_str'] = monthly['YearMonth'].astype(str)

fig, ax = plt.subplots(figsize=(12, 5))
ax.plot(monthly['YearMonth_str'], monthly['Sales'],
        color='#d4820a', linewidth=2.5, marker='o', markersize=4, markerfacecolor='white', markeredgewidth=2)
ax.fill_between(monthly['YearMonth_str'], monthly['Sales'], alpha=0.08, color='#d4820a')

# X-axis — show every 3rd label to avoid crowding
tick_positions = range(0, len(monthly), 3)
ax.set_xticks(list(tick_positions))
ax.set_xticklabels([monthly['YearMonth_str'].iloc[i] for i in tick_positions], rotation=45, ha='right', fontsize=9)

ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f'${x:,.0f}'))
ax.set_title('Monthly Sales Trend', fontsize=14, fontweight='bold', pad=15)
ax.set_xlabel('Month', fontsize=10)
ax.set_ylabel('Total Sales ($)', fontsize=10)

plt.tight_layout()
plt.savefig('chart1_monthly_trend.png', dpi=150, bbox_inches='tight')
plt.show()
print("Saved: chart1_monthly_trend.png ✓")


# Cell 6 — CHART 2: Top 10 Products by Revenue
top_products = (df.groupby('Product Name')['Sales']
                .sum()
                .sort_values(ascending=False)
                .head(10)
                .reset_index())

# Shorten long product names
top_products['Short Name'] = top_products['Product Name'].str[:35] + '...'

fig, ax = plt.subplots(figsize=(10, 6))
bars = ax.barh(top_products['Short Name'], top_products['Sales'],
               color='#d4820a', alpha=0.85, edgecolor='white', linewidth=0.5)

# Add value labels
for bar, val in zip(bars, top_products['Sales']):
    ax.text(val + 500, bar.get_y() + bar.get_height()/2,
            f'${val:,.0f}', va='center', fontsize=8.5, color='#555')

ax.set_title('Top 10 Products by Revenue', fontsize=14, fontweight='bold', pad=15)
ax.set_xlabel('Total Sales ($)', fontsize=10)
ax.xaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f'${x:,.0f}'))
ax.invert_yaxis()

plt.tight_layout()
plt.savefig('chart2_top_products.png', dpi=150, bbox_inches='tight')
plt.show()
print("Saved: chart2_top_products.png ✓")


# Cell 7 — CHART 3: Sales & Profit by Category
category = df.groupby('Category')[['Sales', 'Profit']].sum().reset_index()

x = range(len(category))
width = 0.38
fig, ax = plt.subplots(figsize=(8, 5))
bars1 = ax.bar([i - width/2 for i in x], category['Sales'],
               width, label='Sales', color='#d4820a', alpha=0.85)
bars2 = ax.bar([i + width/2 for i in x], category['Profit'],
               width, label='Profit', color='#4a6c5e', alpha=0.85)

ax.set_xticks(list(x))
ax.set_xticklabels(category['Category'], fontsize=11)
ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f'${x:,.0f}'))
ax.set_title('Sales vs Profit by Category', fontsize=14, fontweight='bold', pad=15)
ax.legend(fontsize=10)

plt.tight_layout()
plt.savefig('chart3_category.png', dpi=150, bbox_inches='tight')
plt.show()
print("Saved: chart3_category.png ✓")


# Cell 8 — CHART 4: Profit vs Sales by Region (scatter)
region_colors = {'West': '#d4820a', 'East': '#4a6c5e', 'Central': '#c04e2a', 'South': '#7a7265'}

fig, ax = plt.subplots(figsize=(9, 6))
for region, group in df.groupby('Region'):
    ax.scatter(group['Sales'], group['Profit'],
               alpha=0.45, s=18,
               color=region_colors.get(region, '#999'),
               label=region)

ax.axhline(0, color='#ccc', linewidth=1, linestyle='--')
ax.set_title('Profit vs Sales by Region', fontsize=14, fontweight='bold', pad=15)
ax.set_xlabel('Sales ($)', fontsize=10)
ax.set_ylabel('Profit ($)', fontsize=10)
ax.xaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f'${x:,.0f}'))
ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f'${x:,.0f}'))
ax.legend(title='Region', fontsize=9)

plt.tight_layout()
plt.savefig('chart4_scatter.png', dpi=150, bbox_inches='tight')
plt.show()
print("Saved: chart4_scatter.png ✓")


# Cell 9 — KEY NUMBERS (these become your "Key Insights" in the portfolio card)
total_sales   = df['Sales'].sum()
total_profit  = df['Profit'].sum()
margin        = (total_profit / total_sales) * 100

top3_revenue  = df.groupby('Product Name')['Sales'].sum().sort_values(ascending=False).head(3).sum()
top3_pct      = (top3_revenue / total_sales) * 100

total_products = df['Product Name'].nunique()
top3_catalog_pct = (3 / total_products) * 100

nov_dec_sales = df[df['Month'].isin([11, 12])]['Sales'].sum()
nov_dec_pct   = (nov_dec_sales / total_sales) * 100

loss_categories = df.groupby('Sub-Category')['Profit'].sum()
losers = loss_categories[loss_categories < 0]

print("=" * 45)
print(f"  Total Sales:      ${total_sales:,.0f}")
print(f"  Total Profit:     ${total_profit:,.0f}")
print(f"  Overall Margin:   {margin:.1f}%")
print("=" * 45)
print(f"  Top 3 products = {top3_pct:.0f}% of revenue")
print(f"  ({top3_catalog_pct:.0f}% of the {total_products} product catalog)")
print("=" * 45)
print(f"  Nov + Dec sales = {nov_dec_pct:.0f}% of annual total")
print("=" * 45)
print(f"  Sub-categories with NEGATIVE profit:")
for name, val in losers.items():
    print(f"    {name}: ${val:,.0f}")
print("=" * 45)
